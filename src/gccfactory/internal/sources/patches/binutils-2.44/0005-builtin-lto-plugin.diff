+  if (handle == BUILTIN_LTO_PLUGIN_HANDLE)
+    return (strcmp (name, "onload") == 0
+	    ? (void *) builtin_lto_plugin_onload : NULL);
+  return dlsym (handle, name);
+}
+
+static int
+plugin_dlclose (void *handle)
+{
+  if (handle == BUILTIN_LTO_PLUGIN_HANDLE)
+    return 0;
+  return dlclose (handle);
