+extern enum ld_plugin_status builtin_lto_plugin_onload (struct ld_plugin_tv *);
+
+static char builtin_lto_plugin_token;
+#define BUILTIN_LTO_PLUGIN_HANDLE ((void *) &builtin_lto_plugin_token)
+
+static bool
+is_builtin_lto_plugin (const char *file)
+{
+  const char *base;
+
+  if (file == NULL)
+    return false;
+  base = strrchr (file, '/');
+  base = base != NULL ? base + 1 : file;
+  return strncmp (base, "liblto_plugin.", 14) == 0;
+}
+
+static void *
+plugin_dlopen (const char *file, int mode)
+{
+  if (is_builtin_lto_plugin (file))
+    return BUILTIN_LTO_PLUGIN_HANDLE;
+  return dlopen (file, mode);
