#!/usr/bin/env bash
# gccf - the only entry point. Builds gccfactory if needed, then runs it.
#
#   ./src/gccf                 print the help (which is the documentation)
#   ./src/gccf build           pick a host x target matrix and build it
#   ./src/gccf status | verify | pack | logs <slug> | shell <slug> | clean | sources
#
# This is a Linux tool. It needs go, a native toolchain, and qemu-user-static.
# Not on Linux? Launch a container yourself; `docker/run` is one way.
#
# Environment: GCCF_DIST GCCF_JOBS GCCF_WORKERS GCCF_QEMU_DIR
set -euo pipefail

if [[ $(uname -s) != Linux ]]; then
  cat >&2 <<EOF
gccf: this is a Linux tool, but you are on $(uname -s).
      Bring your own Linux and run it there. From this repo, one way is:

        docker/run ./src/gccf ${*:-help}
EOF
  exit 1
fi

ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || echo "$0")")/.." && pwd)

export PATH=/usr/local/go/bin:$PATH
command -v go >/dev/null || { echo "gccf: no 'go' on PATH (expected /usr/local/go/bin/go)" >&2; exit 1; }

DIST=${GCCF_DIST:-$ROOT/dist}
BIN=$DIST/.bin/gccfactory
mkdir -p "$(dirname "$BIN")"

# Rebuild only when a source file is newer than the binary. `find -newer` on the
# whole module is cheap and avoids a multi-second go build on every invocation.
# -type d because `git mv` preserves mtime: a moved or deleted patch leaves no
# file newer than the binary, but always bumps its directory's.
# go:embed inputs must be listed too: a new patch or probe changes what the
# binary does without touching a .go file, and silently would not take effect.
needs_build=1
if [[ -x $BIN ]] && [[ -z $(find "$ROOT/src/gccfactory" \( -type d -o -name '*.go' -o -name '*.json' -o -name 'go.mod' -o -name '*.diff' -o -name '*.patch' -o -name '*.c' -o -name '*.cc' -o -name '*.h' \) -newer "$BIN" -print -quit) ]]; then
  needs_build=0
fi
if (( needs_build )); then
  echo "gccf: compiling gccfactory..." >&2
  ( cd "$ROOT/src/gccfactory" && go build -o "$BIN" . )
fi

# Must match unique triple.QemuName() values. A test fails if they drift.
qemu_static_names=(aarch64 arm i386 mips64 ppc64 ppc64le riscv32 riscv64 s390x x86_64)

QEMU_DIR=${GCCF_QEMU_DIR:-/usr/bin}
subcommand=
want_help=0
dry_run=0
build_verify=0
i=0
args=("$@")
while (( i < ${#args[@]} )); do
  case ${args[i]} in
    --qemu-dir)
      QEMU_DIR=${args[i+1]:-}
      i=$((i+2)) ;;
    --qemu-dir=*)
      QEMU_DIR=${args[i]#--qemu-dir=}
      i=$((i+1)) ;;
    --dry-run)
      dry_run=1
      i=$((i+1)) ;;
    --verify)
      build_verify=1
      i=$((i+1)) ;;
    -h|--help|help)
      want_help=1
      i=$((i+1)) ;;
    -*)
      i=$((i+1)) ;;
    *)
      [[ -z $subcommand ]] && subcommand=${args[i]}
      i=$((i+1)) ;;
  esac
done

# The constraint is verification, not compilation. A default build verifies
# each job before publish, so it needs qemu-<arch>-static too.
need_qemu=0
if [[ $want_help -eq 0 ]]; then
  case $subcommand in
    verify) need_qemu=1 ;;
    build)
      if [[ $dry_run -eq 0 ]]; then
        if [[ $build_verify -eq 1 || ${GCCF_SKIP_VERIFY:-} == "" || ${GCCF_SKIP_VERIFY} == 0 ]]; then
          need_qemu=1
        fi
      fi
      ;;
  esac
fi

if (( need_qemu )); then
  missing=()
  for n in "${qemu_static_names[@]}"; do
    if [[ $QEMU_DIR == *%s* ]]; then
      p=${QEMU_DIR//%s/$n}
    else
      p=$QEMU_DIR/qemu-$n-static
    fi
    [[ -x $p ]] || missing+=("$p")
  done
  if (( ${#missing[@]} )); then
    echo "gccf: missing qemu-user-static binaries:" >&2
    printf '      %s\n' "${missing[@]}" >&2
    echo "      install qemu-user-static (Debian/Ubuntu: apt install qemu-user-static)" >&2
    echo "      or point GCCF_QEMU_DIR / --qemu-dir at a directory that holds them." >&2
    echo "      qemu-user + binfmt_misc is not a substitute: verify needs" >&2
    echo "      qemu-<arch>-static -L <sysroot>, and the non-static name is ignored." >&2
    exit 1
  fi
fi

# GCCF_JOBS / GCCF_WORKERS are read by gccfactory itself as flag defaults, so
# they just need to be in the environment; explicit -j/--workers still win.
exec "$BIN" --dist "$DIST" --qemu-dir "$QEMU_DIR" "$@"
